<!-- Diff previews of version control (Commit tool window, VCS Log, Shelf, ...) for jumps.
     Split out so the intellij.platform.vcs.impl dependency does not gate the rest of IdeaVim. -->
<idea-plugin package="com.maddyhome.idea.vim.group.diff.vcs">
  <dependencies>
    <module name="intellij.platform.vcs.impl"/>
  </dependencies>
  <extensions defaultExtensionNs="IdeaVIM">
    <internal.diffTabFiles implementation="com.maddyhome.idea.vim.group.diff.vcs.VcsDiffTabFilesProvider"/>
  </extensions>
</idea-plugin>
