<!-- Git plugin integration for the backend. Split out from ideavim-backend so the Git4Idea
     dependency does not gate the rest of the backend. When the Git plugin is missing or
     disabled, this module is skipped and GitCliClient runs `git` from PATH instead.
     IdeaVIM.ideavim-backend-git-legacy is the variant for IDEs without the intellij.vcs.git.backend module. -->
<idea-plugin>
  <dependencies>
    <module name="IdeaVIM.ideavim-common"/>
    <module name="IdeaVIM.ideavim-backend"/>
    <module name="intellij.vcs.git.backend"/>
  </dependencies>

  <extensions defaultExtensionNs="IdeaVIM">
    <gitExecutableLocator implementation="com.maddyhome.idea.vim.group.git.GitPluginExecutableLocator"/>
  </extensions>
</idea-plugin>
