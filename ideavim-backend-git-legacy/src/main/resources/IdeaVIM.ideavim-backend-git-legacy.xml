<!-- Variant of IdeaVIM.ideavim-backend-git for IDEs (2026.1) where GitExecutableManager is part of
     the Git4Idea plugin main module rather than the intellij.vcs.git.backend content module.
     Both variants share GitPluginExecutableLocator, which answers only when the Git classes are
     resolvable from its own classloader, so exactly one of them is used per IDE. -->
<idea-plugin>
  <dependencies>
    <module name="IdeaVIM.ideavim-common"/>
    <module name="IdeaVIM.ideavim-backend"/>
    <plugin id="Git4Idea"/>
  </dependencies>

  <extensions defaultExtensionNs="IdeaVIM">
    <gitExecutableLocator implementation="com.maddyhome.idea.vim.group.git.GitPluginExecutableLocator"/>
  </extensions>
</idea-plugin>
