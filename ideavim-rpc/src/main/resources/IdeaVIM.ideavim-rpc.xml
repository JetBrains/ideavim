<!-- Provides RemoteApiProviderService to IdeaVIM.ideavim-common on IDEs where intellij.platform.rpc is a module
     (2026.1+). loading="optional", so on 2025.3, where the module doesn't exist, this is a clean skip and
     ideavim-common falls back to the core classloader. -->
<idea-plugin package="com.maddyhome.idea.vim.rpcImpl">
  <dependencies>
    <module name="intellij.platform.rpc"/>
    <module name="IdeaVIM.ideavim-common"/>
  </dependencies>
  <extensions defaultExtensionNs="IdeaVIM">
    <remoteApiResolver implementation="com.maddyhome.idea.vim.rpcImpl.PlatformRemoteApiResolver"/>
  </extensions>
</idea-plugin>
